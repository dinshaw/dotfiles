#!/usr/bin/env bash

set -o errexit
set -o pipefail

DOTFILES_DIR="$(cd "$(dirname "$0")/.." && pwd)"
EXCLUDES=".+(env.sh|git/configuration)$"

printf "Linking dotfiles...\n"

find "$DOTFILES_DIR/home_files" -type f | while read -r source_file; do
  relative="${source_file#$DOTFILES_DIR/home_files/}"
  dest_file="$HOME/$relative"

  if [[ "$relative" =~ $EXCLUDES ]]; then
    continue
  fi

  mkdir -p "$(dirname "$dest_file")"
  ln -sf "$source_file" "$dest_file"
  printf "  %s -> %s\n" "$dest_file" "$source_file"
done

printf "Done!\n"
